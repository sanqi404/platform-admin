# ---- 应用 ----
APP_NAME=运维管理平台
DEBUG=false
API_PREFIX=/api/v1

# ---- 数据库（生产必须外部库；本地开发可退回 SQLite）----
# MySQL / MariaDB（异步驱动 asyncmy）：
DATABASE_URL=mysql+asyncmy://rbac:CHANGE_ME@127.0.0.1:3306/rbac?charset=utf8mb4
# PostgreSQL（异步驱动 asyncpg）：
# DATABASE_URL=postgresql+asyncpg://rbac:CHANGE_ME@127.0.0.1:5432/rbac
# 本地开发：
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_ECHO=false
# 连接池：pool_recycle 必须小于数据库侧 wait_timeout，否则会拿到已被服务端断开的连接
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# 生产置 false，表结构交由 alembic upgrade head 管理
AUTO_CREATE_TABLES=false

# ---- 缓存 / 会话（留空=进程内缓存，仅单实例；多实例必须 Redis）----
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
CACHE_TTL=180
TOKEN_BLACKLIST_ENABLED=true

# ---- JWT（生产必须更换）----
# 生成：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-generate-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- 安全策略 ----
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAIL=5
LOGIN_LOCK_MINUTES=15

# ---- 跨域（填前端实际访问的域名，JSON 数组）----
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- 初始化 ----
INIT_TENANT_CODE=platform
INIT_ADMIN_USERNAME=admin
INIT_ADMIN_PASSWORD=Admin@123456
